rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(ownerUid) {
      return isVerifiedUser() && ownerUid == request.auth.uid;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'romeo.brawlstars59@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPlayerId(playerId) {
      return playerId is string && playerId.size() >= 2 && playerId.size() <= 40 && playerId.matches('^[a-z0-9_\\-]+$');
    }

    function isValidDayKey(dayKey) {
      return dayKey is string && dayKey.size() == 10 && dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidRatingField(val) {
      return (val is int || val is float) && val >= 0 && val <= 4000;
    }

    function isPlayerOwnerAfter(playerId) {
      return existsAfter(/databases/$(database)/documents/players/$(playerId)) &&
        (
          getAfter(/databases/$(database)/documents/players/$(playerId)).data.ownerUid == request.auth.uid ||
          isAdmin()
        );
    }

    // 3. Entity Validation Blueprints (Synchronized with firebase-blueprint.json)
    function isValidPlayerMirror(data, playerId) {
      return data.keys().hasAll([
          'ownerUid', 'username', 'project', 'sourceEngine', 'recordsCount',
          'startElo', 'targetElo', 'startDate', 'targetDate', 'selectedMode',
          'trajectoryModel', 'autoSyncMinutes', 'theme', 'bestRating', 'bestMode',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid', 'username', 'project', 'sourceEngine', 'recordsCount',
          'startElo', 'targetElo', 'startDate', 'targetDate', 'selectedMode',
          'trajectoryModel', 'autoSyncMinutes', 'theme', 'bestRating', 'bestMode',
          'bullet', 'blitz', 'rapid', 'puzzles', 'jsonBinSyncedAt',
          'siteVersion', 'siteVersionNote', 'siteVersionTitle',
          'siteVersionCategory', 'siteVersionHistoryJson', 'siteVersionUpdatedAt',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerUid) &&
        data.ownerUid == request.auth.uid &&
        isValidPlayerId(data.username) &&
        data.username == playerId &&
        data.project is string && data.project.size() >= 1 && data.project.size() <= 64 &&
        data.sourceEngine == 'jsonbin_mirror' &&
        (data.recordsCount is int || data.recordsCount is float) && data.recordsCount >= 0 && data.recordsCount <= 1000 &&
        isValidRatingField(data.startElo) &&
        isValidRatingField(data.targetElo) &&
        data.startDate is string && data.startDate.size() == 10 && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.targetDate is string && data.targetDate.size() >= 10 && data.targetDate.size() <= 40 &&
        data.selectedMode in ['auto', 'bullet', 'blitz', 'rapid'] &&
        data.trajectoryModel in ['linear', 'milestones', 'custom'] &&
        (data.autoSyncMinutes is int || data.autoSyncMinutes is float) && data.autoSyncMinutes >= 0 && data.autoSyncMinutes <= 1440 &&
        data.theme in ['dark', 'light', 'ocean', 'colors', 'system'] &&
        isValidRatingField(data.bestRating) &&
        data.bestMode in ['bullet', 'blitz', 'rapid'] &&
        (!('bullet' in data) || isValidRatingField(data.bullet)) &&
        (!('blitz' in data) || isValidRatingField(data.blitz)) &&
        (!('rapid' in data) || isValidRatingField(data.rapid)) &&
        (!('puzzles' in data) || isValidRatingField(data.puzzles)) &&
        (!('jsonBinSyncedAt' in data) || (data.jsonBinSyncedAt is string && data.jsonBinSyncedAt.size() <= 64)) &&
        (!('siteVersion' in data) || (data.siteVersion is string && data.siteVersion.size() >= 1 && data.siteVersion.size() <= 24)) &&
        (!('siteVersionNote' in data) || (data.siteVersionNote is string && data.siteVersionNote.size() <= 600)) &&
        (!('siteVersionTitle' in data) || (data.siteVersionTitle is string && data.siteVersionTitle.size() <= 120)) &&
        (!('siteVersionCategory' in data) || data.siteVersionCategory in ['major', 'feature', 'improvement', 'fix', 'security']) &&
        (!('siteVersionHistoryJson' in data) || (data.siteVersionHistoryJson is string && data.siteVersionHistoryJson.size() <= 32000)) &&
        (!('siteVersionUpdatedAt' in data) || (data.siteVersionUpdatedAt is string && data.siteVersionUpdatedAt.size() <= 64)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidDailySyncRecord(data, playerId, dayKey) {
      return data.keys().hasAll([
          'ownerUid', 'recordId', 'username', 'dayKey', 'timestamp',
          'bestRating', 'bestMode', 'source', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid', 'recordId', 'username', 'dayKey', 'timestamp',
          'bestRating', 'bestMode', 'source', 'bullet', 'blitz', 'rapid',
          'puzzles', 'note', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerUid) &&
        data.ownerUid == request.auth.uid &&
        data.recordId is string && data.recordId.size() >= 1 && data.recordId.size() <= 80 && data.recordId.matches('^[a-zA-Z0-9_\\-]+$') &&
        isValidPlayerId(data.username) &&
        data.username == playerId &&
        isValidDayKey(data.dayKey) &&
        data.dayKey == dayKey &&
        data.timestamp is string && data.timestamp.size() >= 10 && data.timestamp.size() <= 64 &&
        isValidRatingField(data.bestRating) &&
        data.bestMode in ['bullet', 'blitz', 'rapid'] &&
        data.source is string && data.source.size() >= 1 && data.source.size() <= 64 &&
        (!('bullet' in data) || isValidRatingField(data.bullet)) &&
        (!('blitz' in data) || isValidRatingField(data.blitz)) &&
        (!('rapid' in data) || isValidRatingField(data.rapid)) &&
        (!('puzzles' in data) || isValidRatingField(data.puzzles)) &&
        (!('note' in data) || (data.note is string && data.note.size() <= 240)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'linkedPlayer', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'linkedPlayer', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.uid == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        isValidPlayerId(data.linkedPlayer) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidSiteActivityState(data, configId) {
      return configId == 'global' &&
        data.keys().hasAll([
          'configId', 'enabled', 'mode', 'customTitle', 'customMessage',
          'scheduleType', 'countdownMinutes', 'resumeType', 'resumeDurationMinutes',
          'autoResume', 'showCountdownBanner', 'devicesAll', 'devicesDesktop',
          'devicesMobile', 'devicesTablet', 'iframePolicy', 'ipPolicyMode',
          'ipPolicyIps', 'ipPolicyExemptTrustedAdminIps', 'allowAdminBypass',
          'revision', 'updatedAtMs', 'updatedBy', 'updatedByUid',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'configId', 'enabled', 'mode', 'customTitle', 'customMessage',
          'upcomingVersion', 'extendedDetails',
          'scheduleType', 'countdownMinutes', 'pauseAtTimestamp', 'resumeType',
          'resumeDurationMinutes', 'resumeAtTimestamp', 'autoResume',
          'showCountdownBanner', 'devicesAll', 'devicesDesktop', 'devicesMobile',
          'devicesTablet', 'iframePolicy', 'ipPolicyMode', 'ipPolicyIps',
          'ipPolicyExemptTrustedAdminIps', 'allowAdminBypass', 'revision',
          'updatedAtMs', 'updatedBy', 'updatedByUid', 'createdAt', 'updatedAt'
        ]) &&
        data.configId == 'global' &&
        data.enabled is bool &&
        data.mode in ['arret', 'maintenance', 'administration', 'moderation', 'mise_a_jour'] &&
        data.customTitle is string && data.customTitle.size() >= 1 && data.customTitle.size() <= 120 &&
        data.customMessage is string && data.customMessage.size() >= 1 && data.customMessage.size() <= 2000 &&
        (!('upcomingVersion' in data) || (data.upcomingVersion is string && data.upcomingVersion.size() <= 32)) &&
        (!('extendedDetails' in data) || (data.extendedDetails is string && data.extendedDetails.size() <= 2500)) &&
        data.scheduleType in ['immediate', 'countdown', 'exact_date'] &&
        (data.countdownMinutes is int || data.countdownMinutes is float) && data.countdownMinutes >= 1 && data.countdownMinutes <= 10080 &&
        (!('pauseAtTimestamp' in data) || ((data.pauseAtTimestamp is int || data.pauseAtTimestamp is float) && data.pauseAtTimestamp >= 0)) &&
        data.resumeType in ['manual', 'duration', 'exact_date'] &&
        (data.resumeDurationMinutes is int || data.resumeDurationMinutes is float) && data.resumeDurationMinutes >= 1 && data.resumeDurationMinutes <= 43200 &&
        (!('resumeAtTimestamp' in data) || ((data.resumeAtTimestamp is int || data.resumeAtTimestamp is float) && data.resumeAtTimestamp >= 0)) &&
        data.autoResume is bool &&
        data.showCountdownBanner is bool &&
        data.devicesAll is bool &&
        data.devicesDesktop is bool &&
        data.devicesMobile is bool &&
        data.devicesTablet is bool &&
        data.iframePolicy in ['block_all', 'block_only_iframes', 'allow_iframes'] &&
        data.ipPolicyMode in ['all', 'except_list', 'only_list'] &&
        data.ipPolicyIps is list && data.ipPolicyIps.size() <= 50 &&
        (data.ipPolicyIps.size() == 0 || (data.ipPolicyIps[0] is string && data.ipPolicyIps[0].size() <= 64)) &&
        data.ipPolicyExemptTrustedAdminIps is bool &&
        data.allowAdminBypass is bool &&
        (data.revision is int || data.revision is float) && data.revision >= 0 &&
        (data.updatedAtMs is int || data.updatedAtMs is float) && data.updatedAtMs >= 0 &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 80 &&
        isValidId(data.updatedByUid) &&
        data.updatedByUid == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    // 4. Collection Rules
    match /players/{playerId} {
      allow get: if isValidPlayerId(playerId) && isVerifiedUser() && (
        isAdmin() || resource == null || resource.data.ownerUid == request.auth.uid
      );
      allow list: if isVerifiedUser() && (
        isAdmin() || resource.data.ownerUid == request.auth.uid
      );
      allow create: if isValidPlayerId(playerId) &&
        isVerifiedUser() &&
        isValidPlayerMirror(incoming(), playerId) &&
        incoming().createdAt == request.time &&
        (isOwner(incoming().ownerUid) || isAdmin());
      allow update: if isValidPlayerId(playerId) &&
        isVerifiedUser() &&
        isValidPlayerMirror(incoming(), playerId) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().username == existing().username &&
        incoming().createdAt == existing().createdAt &&
        (isOwner(existing().ownerUid) || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'recordsCount', 'startElo', 'targetElo', 'startDate', 'targetDate',
          'selectedMode', 'trajectoryModel', 'autoSyncMinutes', 'theme',
          'bestRating', 'bestMode', 'bullet', 'blitz', 'rapid', 'puzzles',
          'jsonBinSyncedAt', 'siteVersion', 'siteVersionNote', 'siteVersionTitle',
          'siteVersionCategory', 'siteVersionHistoryJson', 'siteVersionUpdatedAt',
          'updatedAt'
        ]);
      allow delete: if isValidPlayerId(playerId) &&
        isVerifiedUser() &&
        (isOwner(existing().ownerUid) || isAdmin());

      match /dailyRecords/{dayKey} {
        allow get: if isValidPlayerId(playerId) &&
          isValidDayKey(dayKey) &&
          isVerifiedUser() && (
            isAdmin() || resource == null || resource.data.ownerUid == request.auth.uid
          );
        allow list: if isVerifiedUser() && (
          isAdmin() || resource.data.ownerUid == request.auth.uid
        );
        allow create: if isValidPlayerId(playerId) &&
          isValidDayKey(dayKey) &&
          isVerifiedUser() &&
          isValidDailySyncRecord(incoming(), playerId, dayKey) &&
          incoming().createdAt == request.time &&
          isPlayerOwnerAfter(playerId);
        allow update: if isValidPlayerId(playerId) &&
          isValidDayKey(dayKey) &&
          isVerifiedUser() &&
          isValidDailySyncRecord(incoming(), playerId, dayKey) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().username == existing().username &&
          incoming().dayKey == existing().dayKey &&
          incoming().createdAt == existing().createdAt &&
          isPlayerOwnerAfter(playerId) &&
          (isOwner(existing().ownerUid) || isAdmin()) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'recordId', 'timestamp', 'bestRating', 'bestMode', 'source',
            'bullet', 'blitz', 'rapid', 'puzzles', 'note', 'updatedAt'
          ]);
        allow delete: if isValidPlayerId(playerId) &&
          isValidDayKey(dayKey) &&
          isVerifiedUser() &&
          (isOwner(existing().ownerUid) || isAdmin()) &&
          isPlayerOwnerAfter(playerId);
      }
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (userId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(userId) &&
        isVerifiedUser() &&
        isValidUserAccount(incoming(), userId) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(userId) &&
        isVerifiedUser() &&
        isValidUserAccount(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        (userId == request.auth.uid || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'linkedPlayer', 'updatedAt']);
      allow delete: if isValidId(userId) && isVerifiedUser() && (userId == request.auth.uid || isAdmin());
    }

    // Real-time Site Activity / Maintenance Pause Control
    match /siteActivity/{configId} {
      allow get: if configId == 'global';
      allow list: if false;
      allow create: if configId == 'global' &&
        isAdmin() &&
        isValidSiteActivityState(incoming(), configId) &&
        incoming().createdAt == request.time;
      allow update: if configId == 'global' &&
        isAdmin() &&
        isValidSiteActivityState(incoming(), configId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().configId == existing().configId &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'enabled', 'mode', 'customTitle', 'customMessage', 'upcomingVersion', 'extendedDetails',
          'scheduleType', 'countdownMinutes', 'pauseAtTimestamp', 'resumeType', 'resumeDurationMinutes',
          'resumeAtTimestamp', 'autoResume', 'showCountdownBanner', 'devicesAll',
          'devicesDesktop', 'devicesMobile', 'devicesTablet', 'iframePolicy',
          'ipPolicyMode', 'ipPolicyIps', 'ipPolicyExemptTrustedAdminIps',
          'allowAdminBypass', 'revision', 'updatedAtMs', 'updatedBy',
          'updatedByUid', 'updatedAt'
        ]);
      allow delete: if configId == 'global' && isAdmin();
    }

    // Read-only admins lookup collection (no client writes allowed)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isVerifiedUser() && adminId == request.auth.uid;
      allow list, create, update, delete: if false;
    }

    // Connection diagnostic check document
    match /test/{docId} {
      allow get: if isValidId(docId) && isVerifiedUser();
      allow list, create, update, delete: if false;
    }
  }
}
