{
  "entities": {
    "PlayerMirror": {
      "title": "PlayerMirror",
      "description": "Mirrored Chess.com Road to 2000 Elo player profile, trajectory configuration, and latest summary snapshot synced from JSONBin.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the authenticated owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "Normalized Chess.com username (lowercase).",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "project": {
          "type": "string",
          "description": "Project label identifier.",
          "minLength": 1,
          "maxLength": 64
        },
        "sourceEngine": {
          "type": "string",
          "description": "Indicates mirror origin.",
          "enum": ["jsonbin_mirror"]
        },
        "recordsCount": {
          "type": "number",
          "description": "Count of mirrored daily sync records."
        },
        "startElo": {
          "type": "number",
          "description": "Challenge baseline Elo."
        },
        "targetElo": {
          "type": "number",
          "description": "Challenge target Elo."
        },
        "startDate": {
          "type": "string",
          "description": "ISO date YYYY-MM-DD of challenge start.",
          "minLength": 10,
          "maxLength": 20,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "targetDate": {
          "type": "string",
          "description": "ISO datetime string of challenge deadline.",
          "minLength": 10,
          "maxLength": 40
        },
        "selectedMode": {
          "type": "string",
          "description": "Primary tracked cadence or auto.",
          "enum": ["auto", "bullet", "blitz", "rapid"]
        },
        "trajectoryModel": {
          "type": "string",
          "description": "Theoretical curve calculation model.",
          "enum": ["linear", "milestones", "custom"]
        },
        "autoSyncMinutes": {
          "type": "number",
          "description": "Auto-sync interval in minutes."
        },
        "theme": {
          "type": "string",
          "description": "Active application visual theme.",
          "enum": ["dark", "light", "ocean", "colors", "system"]
        },
        "bestRating": {
          "type": "number",
          "description": "Latest best Elo across tracked cadences."
        },
        "bestMode": {
          "type": "string",
          "description": "Cadence corresponding to bestRating.",
          "enum": ["bullet", "blitz", "rapid"]
        },
        "bullet": {
          "type": "number",
          "description": "Optional latest Bullet Elo."
        },
        "blitz": {
          "type": "number",
          "description": "Optional latest Blitz Elo."
        },
        "rapid": {
          "type": "number",
          "description": "Optional latest Rapid Elo."
        },
        "puzzles": {
          "type": "number",
          "description": "Optional latest Puzzles rating."
        },
        "jsonBinSyncedAt": {
          "type": "string",
          "description": "ISO timestamp of the source JSONBin snapshot.",
          "maxLength": 64
        },
        "siteVersion": {
          "type": "string",
          "description": "Owner-managed published site version label.",
          "minLength": 1,
          "maxLength": 24
        },
        "siteVersionNote": {
          "type": "string",
          "description": "Optional release note for the published site version.",
          "maxLength": 600
        },
        "siteVersionTitle": {
          "type": "string",
          "description": "Optional headline title for the published site version.",
          "maxLength": 120
        },
        "siteVersionCategory": {
          "type": "string",
          "description": "Category tag of the published site version.",
          "enum": ["major", "feature", "improvement", "fix", "security"]
        },
        "siteVersionHistoryJson": {
          "type": "string",
          "description": "JSON-serialized release history list for cross-device version changelog sync.",
          "maxLength": 32000
        },
        "siteVersionUpdatedAt": {
          "type": "string",
          "description": "ISO timestamp when the site version was updated.",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerUid",
        "username",
        "project",
        "sourceEngine",
        "recordsCount",
        "startElo",
        "targetElo",
        "startDate",
        "targetDate",
        "selectedMode",
        "trajectoryModel",
        "autoSyncMinutes",
        "theme",
        "bestRating",
        "bestMode",
        "createdAt",
        "updatedAt"
      ]
    },
    "DailySyncRecord": {
      "title": "DailySyncRecord",
      "description": "Single daily Elo synchronization snapshot mirrored from JSONBin.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the authenticated owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recordId": {
          "type": "string",
          "description": "Client sync record identifier.",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "Normalized Chess.com username.",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "dayKey": {
          "type": "string",
          "description": "Europe/Paris calendar key YYYY-MM-DD.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 timestamp of the sync record.",
          "minLength": 10,
          "maxLength": 64
        },
        "bestRating": {
          "type": "number",
          "description": "Highest cadence Elo on that day."
        },
        "bestMode": {
          "type": "string",
          "description": "Cadence achieving bestRating.",
          "enum": ["bullet", "blitz", "rapid"]
        },
        "source": {
          "type": "string",
          "description": "Origin label of the sync.",
          "minLength": 1,
          "maxLength": 64
        },
        "bullet": {
          "type": "number",
          "description": "Optional Bullet Elo."
        },
        "blitz": {
          "type": "number",
          "description": "Optional Blitz Elo."
        },
        "rapid": {
          "type": "number",
          "description": "Optional Rapid Elo."
        },
        "puzzles": {
          "type": "number",
          "description": "Optional Puzzles rating."
        },
        "note": {
          "type": "string",
          "description": "Optional daily annotation.",
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerUid",
        "recordId",
        "username",
        "dayKey",
        "timestamp",
        "bestRating",
        "bestMode",
        "source",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Minimal non-PII user link record for Firebase Auth owner.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Public display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "linkedPlayer": {
          "type": "string",
          "description": "Linked Chess.com username.",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "displayName", "linkedPlayer", "createdAt", "updatedAt"]
    },
    "SiteActivityState": {
      "title": "SiteActivityState",
      "description": "Global site maintenance, pause, countdown, device/iframe/IP targeting state for instant cross-device enforcement.",
      "type": "object",
      "properties": {
        "configId": {
          "type": "string",
          "enum": ["global"]
        },
        "enabled": { "type": "boolean" },
        "mode": {
          "type": "string",
          "enum": ["arret", "maintenance", "administration", "moderation", "mise_a_jour"]
        },
        "customTitle": { "type": "string", "minLength": 1, "maxLength": 120 },
        "customMessage": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "upcomingVersion": { "type": "string", "maxLength": 32 },
        "extendedDetails": { "type": "string", "maxLength": 2500 },
        "scheduleType": {
          "type": "string",
          "enum": ["immediate", "countdown", "exact_date"]
        },
        "countdownMinutes": { "type": "number" },
        "pauseAtTimestamp": { "type": "number" },
        "resumeType": {
          "type": "string",
          "enum": ["manual", "duration", "exact_date"]
        },
        "resumeDurationMinutes": { "type": "number" },
        "resumeAtTimestamp": { "type": "number" },
        "autoResume": { "type": "boolean" },
        "showCountdownBanner": { "type": "boolean" },
        "devicesAll": { "type": "boolean" },
        "devicesDesktop": { "type": "boolean" },
        "devicesMobile": { "type": "boolean" },
        "devicesTablet": { "type": "boolean" },
        "iframePolicy": {
          "type": "string",
          "enum": ["block_all", "block_only_iframes", "allow_iframes"]
        },
        "ipPolicyMode": {
          "type": "string",
          "enum": ["all", "except_list", "only_list"]
        },
        "ipPolicyIps": { "type": "array" },
        "ipPolicyExemptTrustedAdminIps": { "type": "boolean" },
        "allowAdminBypass": { "type": "boolean" },
        "revision": { "type": "number" },
        "updatedAtMs": { "type": "number" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 80 },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "configId",
        "enabled",
        "mode",
        "customTitle",
        "customMessage",
        "scheduleType",
        "countdownMinutes",
        "resumeType",
        "resumeDurationMinutes",
        "autoResume",
        "showCountdownBanner",
        "devicesAll",
        "devicesDesktop",
        "devicesMobile",
        "devicesTablet",
        "iframePolicy",
        "ipPolicyMode",
        "ipPolicyIps",
        "ipPolicyExemptTrustedAdminIps",
        "allowAdminBypass",
        "revision",
        "updatedAtMs",
        "updatedBy",
        "updatedByUid",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/players/{playerId}": {
      "schema": { "$ref": "#/entities/PlayerMirror" },
      "description": "Primary player profile, settings, and latest summary snapshot per Chess.com username."
    },
    "/players/{playerId}/dailyRecords/{dayKey}": {
      "schema": { "$ref": "#/entities/DailySyncRecord" },
      "description": "Daily Elo sync snapshots stored under each player."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Owner-only non-PII account metadata linking Firebase Auth UID to tracked player."
    },
    "/siteActivity/{configId}": {
      "schema": { "$ref": "#/entities/SiteActivityState" },
      "description": "Real-time global site activity / maintenance block state for instant cross-device updates."
    }
  }
}
